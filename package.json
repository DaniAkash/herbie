{
  "name": "herbie",
  "version": "0.0.1",
  "description": "Lightweight AI assistant menubar app",
  "scripts": {
    "start": "vite build && electrobun dev",
    "build": "vite build",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write --unsafe"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@tanstack/react-router": "^1.168.4",
    "@tailwindcss/vite": "^4.2.2",
    "ai": "^6.0.138",
    "clsx": "^2.1.1",
    "electrobun": "1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@tanstack/router-plugin": "^1.167.5",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
