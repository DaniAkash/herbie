node_modules/
dist/
.fallow/
*.local
.env
.env.*
!.env.example

# The compiled sidecar. Rebuilt by `bun run build:sidecar`, never committed:
# it is a platform-specific binary the size of the Bun runtime.
apps/desktop/src-tauri/binaries/

# Some machines carry a global gitignore that blanket-ignores `lib/`, which
# would silently drop apps/desktop/src/lib/utils.ts from a commit and leave
# the app building locally and failing in CI.
!apps/desktop/src/lib/
!apps/desktop/src/lib/**

# Cargo's final artifacts. Intermediates live in CARGO_HOME via .cargo/config.toml.
apps/desktop/src-tauri/target/
# Generated by tauri-build from tauri.conf.json and the capabilities.
apps/desktop/src-tauri/gen/

# Scratch files bun leaves behind while compiling the sidecar.
*.bun-build

# Generated by the TanStack Router plugin from the files in src/routes.
apps/desktop/src/routeTree.gen.ts
