{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/src-tauri/target",
      "!**/src-tauri/gen",
      "!apps/desktop/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error"
      },
      "style": {
        "noProcessEnv": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 300 }
        }
      },
      "nursery": {
        "useSortedClasses": "error"
      }
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@bun/**",
                      "!@bun/server/client",
                      "!@bun/shared/**"
                    ],
                    "message": "The webview reaches the sidecar through @bun/server/client and @bun/shared only. Anything else drags bun:sqlite into the browser bundle."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src-bun/lib/env.ts",
        "apps/desktop/vite.config.ts",
        "apps/desktop/scripts/**"
      ],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": [
        "apps/desktop/src/components/atoms/**",
        "apps/desktop/src/components/primitives/**",
        "apps/desktop/src/components/motion/**",
        "apps/desktop/src/components/agents/**",
        "apps/desktop/src/components/ui/**"
      ],
      "linter": {
        "rules": {
          "style": { "noExcessiveLinesPerFile": "off" },
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "suspicious": { "noExplicitAny": "off" },
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "nursery": { "useSortedClasses": "off" }
        }
      }
    }
  ]
}
