{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Herbie window is allowed to do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "core:window:allow-set-badge-count",
    "shell:allow-open",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    }
  ]
}
