{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@bun/*": ["./src-bun/*"]
    }
  },
  // The webview reaches the sidecar for its types through @bun/server/client.
  // Without this reference tsc refuses those files as outside the project.
  "references": [{ "path": "./tsconfig.bun.json" }],
  "include": ["src"]
}
