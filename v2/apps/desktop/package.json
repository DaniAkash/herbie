{
  "name": "herbie-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "HERBIE_DEV=1 vite",
    "dev:app": "bun run build:sidecar && tauri dev",
    "dev:web": "HERBIE_DEV=1 vite",
    "dev:sidecar": "HERBIE_DEV=1 bun src-bun/index.ts",
    "build": "vite build",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b",
    "test": "bun test src-bun src",
    "tauri": "tauri",
    "ui:add": "bun scripts/ui-add.ts",
    "db:generate": "drizzle-kit generate",
    "check:rust": "bun run build:sidecar && cd src-tauri && cargo clippy --all-targets",
    "fix:rust": "cd src-tauri && cargo clippy --all-targets --fix --allow-dirty --allow-staged",
    "seed:dev": "HERBIE_DEV=1 bun src-bun/seed-dev.ts"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.3",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/outfit": "^5.2.8",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-router": "^1.168.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.7.0",
    "acp-probe": "2.0.0",
    "acpx": "0.21.1",
    "acpx-ai-provider": "2.0.2",
    "agent-mcp-manager": "0.2.0",
    "agent-skills-manager": "2.0.0",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "liveline": "^0.0.7",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.91.0",
    "react-query-kit": "^3.3.3",
    "shadow-plugin": "^2.1.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-cli": "^1.167.5",
    "@tanstack/router-plugin": "^1.167.5",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3"
  }
}
