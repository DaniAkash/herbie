{
  "name": "herbie-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "bun run build:sidecar && tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "bun test src-bun",
    "tauri": "tauri",
    "ui:add": "bun scripts/ui-add.ts",
    "db:generate": "drizzle-kit generate",
    "check:rust": "bun run build:sidecar && cd src-tauri && cargo clippy --all-targets",
    "fix:rust": "cd src-tauri && cargo clippy --all-targets --fix --allow-dirty --allow-staged"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@tanstack/react-query": "^5.100.7",
    "@tanstack/react-router": "^1.168.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-query-kit": "^3.3.3",
    "shadow-plugin": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.5",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "shadcn": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.3"
  }
}
